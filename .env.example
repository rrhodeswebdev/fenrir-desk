# Fenrir Desk settings. Copy to .env and fill in. Never commit .env.
# London Strategic Edge API key (market data).
FENRIR_LSE_API_KEY=
# NinjaTrader add-on address: host.docker.internal on the same Windows host, the VM's IP for macOS + VM.
FENRIR_NT_URL=http://host.docker.internal:8123
# Shared token; must match the add-on's token.
FENRIR_NT_TOKEN=
# Most recent months held out of tuning runs.
FENRIR_HOLDOUT_MONTHS=12
# Halt an account for the day once this % of its daily loss limit is used.
FENRIR_SAFETY_MARGIN_PCT=80
# Pause new entries when no LSE bar arrives for this many seconds in session.
FENRIR_STALE_SECONDS=90
# On lost NinjaTrader heartbeat with an open position: keep (bracket stays) or flatten.
FENRIR_HEARTBEAT_POLICY=keep
FENRIR_DATA_DIR=data
FENRIR_RULES_DIR=rules
FENRIR_STRATEGIES_DIR=strategies
