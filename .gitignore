# Secrets and local config. Never commit API keys, broker or data-provider credentials.
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config.local.*

# Market data caches and backtest output (can be large and may be licensed)
data/
!data/.gitkeep
*.parquet
*.feather
*.duckdb
*.duckdb.wal
*.sqlite
*.sqlite3
*.db
backtests/output/
reports/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node
node_modules/
dist/
build/
.next/
.vite/
coverage/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# .NET / NinjaScript build output
bin/
obj/
*.user
*.suo
.vs/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Claude Code local settings
.claude/settings.local.json

# Impeccable working files (review captures, downloaded references, decision mocks)
.impeccable/review/
.impeccable/refs/
.impeccable/mocks/

# Superpowers specs and plans (local only)
docs/superpowers/
